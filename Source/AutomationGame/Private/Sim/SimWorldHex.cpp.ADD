// Patch: In USimWorldHex::PlaceTile, handle Empty as remove:
bool USimWorldHex::PlaceTile(const FHex& H, const FTile& T)
{
    if (T.Kind == ETileKind::Empty)
    {
        TileMap.Remove(H);
        ItemMap.Remove(H); // clear any item that was on it
        return true;
    }
    TileMap.Add(H, T); // overwrite/insert
    return true;
}
